# Local FastAPI process. BuildMate Node calls http://127.0.0.1:8000.
HOST=127.0.0.1
PORT=8000
APP_DEBUG=False

ALLOWED_ORIGINS=["*"]

# Must match BuildMate backend EKYC_INTERNAL_TOKEN. Leave empty in this example.
EKYC_INTERNAL_TOKEN=

# Hugging Face token for the CCCD model repo. Download happens at runtime.
# Do not commit a real token.
HF_TOKEN=
HF_REPO_ID=phamminhanh2004/hotel-cccd-ocr-v11
HF_REVISION=
HF_ONNX_MODEL_FILE=yolo11m_best.pt
VIETOCR_REPO_ID=phamminhanh2004/hotel-cccd-ocr-v11
VIETOCR_WEIGHTS_FILE=best_ocr.pth
VIETOCR_REVISION=
OCR_REVISION=
VIETOCR_CONFIG=vgg_transformer
VIETOCR_CONFIG_PATH=config/vietocr-vgg-transformer.yml

DEEPFACE_MODEL=Facenet512
DEEPFACE_DETECTOR=opencv
DEEPFACE_DISTANCE=cosine
FACE_MATCH_THRESHOLD=0.30
FACE_MATCH_REVIEW_THRESHOLD=0.42
FACE_ENROLLMENT_CONSISTENCY_THRESHOLD=0.55
LIVENESS_MIN_SCORE=0.75
FACE_READINESS_MIN_SIZE=80
ACTIVE_LIVENESS_CENTER_MAX_YAW=0.12
ACTIVE_LIVENESS_SIDE_MIN_YAW=0.15
ACTIVE_LIVENESS_MIN_YAW_RANGE=0.32
ACTIVE_LIVENESS_VERTICAL_MIN_DELTA=0.06
ACTIVE_LIVENESS_MIN_PITCH_RANGE=0.13
EXPRESS_LIVENESS_CENTER_MAX_YAW=0.15
EXPRESS_LIVENESS_SIDE_MIN_YAW=0.10
EXPRESS_LIVENESS_MIN_YAW_DELTA=0.08

CCCD_YOLO_IMAGE_SIZE=640
CCCD_YOLO_CONFIDENCE=0.01
CCCD_YOLO_IOU=0.45
CCCD_YOLO_AGNOSTIC_NMS=True

OCR_DEVICE=auto
OCR_CROP_HEIGHT=80
OCR_PADDING_PIXELS=6
REQUEST_TIMEOUT=15

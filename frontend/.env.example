VITE_API_URL=http://localhost:5000/api
# VietMap Tilemap key (public). The map SDK loads vector tiles in the browser.
# Use the Tilemap key from the VietMap console, not the Services key.
# A Services key returns HTTP 423 without CORS headers, which Chrome reports as a CORS error.
# Address search does not use this key. Autocomplete, place, and reverse go through the API.
VITE_VIETMAP_API_KEY=

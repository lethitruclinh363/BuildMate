generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_logs {
  id              BigInt   @id @default(autoincrement())
  legacy_mongo_id String?  @unique @db.VarChar(24)
  actor_user_id   BigInt?
  actor_role      String   @default("") @db.VarChar(50)
  action          String   @db.VarChar(50)
  entity_type     String   @db.VarChar(100)
  entity_id       String   @default("") @db.VarChar(100)
  meta            Json     @default("{}")
  ip              String   @default("") @db.VarChar(100)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  users           users?   @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction, map: "fk_audit_logs_actor")

  @@index([action, created_at(sort: Desc)], map: "idx_audit_logs_action_created")
  @@index([actor_user_id], map: "idx_audit_logs_actor")
  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model catalog_services {
  id                                        BigInt                          @id @default(autoincrement())
  legacy_mongo_id                           String?                         @unique @db.VarChar(24)
  service_category_id                       BigInt
  name                                      String                          @db.VarChar(80)
  normalized_name                           String                          @unique(map: "uq_catalog_services_normalized_name") @db.VarChar(120)
  folded_name                               String                          @default("") @db.VarChar(120)
  code                                      String?                         @db.VarChar(160)
  description                               String                          @default("") @db.VarChar(500)
  catalog_type                              String                          @default("CUSTOM") @db.VarChar(20)
  status                                    String                          @default("PENDING_APPROVAL") @db.VarChar(30)
  proposed_by                               BigInt?
  reviewed_by                               BigInt?
  reviewed_at                               DateTime?                       @db.Timestamptz(6)
  created_at                                DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime                        @default(now()) @db.Timestamptz(6)
  service_categories                        service_categories              @relation(fields: [service_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_services_category")
  users_catalog_services_proposed_byTousers users?                          @relation("catalog_services_proposed_byTousers", fields: [proposed_by], references: [id], onUpdate: NoAction, map: "fk_catalog_services_proposed_by")
  users_catalog_services_reviewed_byTousers users?                          @relation("catalog_services_reviewed_byTousers", fields: [reviewed_by], references: [id], onUpdate: NoAction, map: "fk_catalog_services_reviewed_by")
  contractor_portfolio_projects             contractor_portfolio_projects[]
  contractor_profile_services               contractor_profile_services[]
  repair_requests                           repair_requests[]
  service_suggestions                       service_suggestions[]
  services                                  services[]

  @@index([service_category_id], map: "idx_catalog_services_category")
  @@index([status], map: "idx_catalog_services_status")
}

model chat_rooms {
  id                                         BigInt          @id @default(autoincrement())
  legacy_mongo_id                            String?         @unique @db.VarChar(24)
  customer_user_id                           BigInt
  contractor_user_id                         BigInt
  repair_request_id                          BigInt          @unique
  last_message                               String          @default("")
  last_message_at                            DateTime        @default(now()) @db.Timestamptz(6)
  created_at                                 DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime        @default(now()) @db.Timestamptz(6)
  users_chat_rooms_contractor_user_idTousers users           @relation("chat_rooms_contractor_user_idTousers", fields: [contractor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_chat_rooms_contractor")
  users_chat_rooms_customer_user_idTousers   users           @relation("chat_rooms_customer_user_idTousers", fields: [customer_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_chat_rooms_customer")
  repair_requests                            repair_requests @relation(fields: [repair_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_rooms_request")
  messages                                   messages[]
  quotations                                 quotations[]

  @@index([contractor_user_id, last_message_at(sort: Desc)], map: "idx_chat_rooms_contractor_last")
  @@index([customer_user_id, last_message_at(sort: Desc)], map: "idx_chat_rooms_customer_last")
}


# PostgreSQL migration connection only.
# Keep backend/.env unchanged for now; it already contains MONGODB_URI.
PGHOST="171.244.39.202"
PGPORT="5432"
PGDATABASE="BuilMate"
PGUSER="BuilMate"
PGPASSWORD="buildmate@123"

# Most self-managed PostgreSQL servers use false. Set true only if your server requires SSL.
PGSSL="false"
# If PGSSL=true and your server has a trusted certificate, keep this true.
# For a server using a self-signed certificate, set false only if required by your environment.
PGSSL_REJECT_UNAUTHORIZED="true"

# Safety: Phase 1 expects no previously migrated Mongo users in PostgreSQL.
MIGRATION_ALLOW_NONEMPTY="false"
# Database connection (PostgreSQL + Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/BuilMate

# Server-only VietMap Services key for autocomplete, place, and reverse.
# Do not commit a real key. Do not put this key in VITE_VIETMAP_API_KEY.
# Map tiles use the separate Tilemap key in frontend/.env.
VIETMAP_API_KEY=

# Google OAuth Web client ID. Use the same ID as frontend/VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Integration tests must use an isolated test database.
# TEST_DATABASE_URL=postgresql://buildmate_test:password@localhost:55432/BuilMate_test

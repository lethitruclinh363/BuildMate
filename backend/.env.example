PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/buildmate
JWT_SECRET=replace-with-a-long-random-secret-32ch
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,http://localhost:5174
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=8
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=500
RATE_LIMIT_AUTH_MAX=30

# Gmail SMTP — dùng App Password (không dùng mật khẩu Gmail thường)
# 1. Bật 2-Step Verification
# 2. Tạo App Password: https://myaccount.google.com/apppasswords
# 3. Dán 16 ký tự vào EMAIL_PASSWORD (bỏ khoảng trắng cũng được)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your.email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM="BuildMate <your.email@gmail.com>"

# Tên cũ — vẫn đọc được nếu chưa đổi sang EMAIL_*
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BuildMate <noreply@gmail.com>"

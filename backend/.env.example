# Server-only VietMap Services key for autocomplete, place, and reverse.
# Do not commit a real key. Do not put this key in VITE_VIETMAP_API_KEY.
# Map tiles use the separate Tilemap key in frontend/.env.
VIETMAP_API_KEY=

# Auth/User data source. mongo keeps the current Mongoose path.
# postgres reads and writes public.users through Prisma. Other domains stay on MongoDB.
DATABASE_PROVIDER=mongo

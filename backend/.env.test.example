# Copy to backend/.env.test after the isolated database is up. Do not commit.
# Never point this at BuilMate. Host must be localhost / 127.0.0.1 unless
# TEST_ALLOW_REMOTE=yes is set after an explicit review.
#
# Docker path (preferred, port 55432, does not use local PostgreSQL 18):
#   npm run test:db:up
#   npm run test:db:bootstrap
#
# NODE_ENV=test
# TEST_DATABASE_URL=postgresql://buildmate_test:PASSWORD@127.0.0.1:55432/BuilMate_test
